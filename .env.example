# Single source of configuration: Docker Compose reads this file and injects it into the Laravel container.
# Copy to .env and fill in the values.
APP_NAME=Reservo
APP_ENV=local
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=reservo
DB_USERNAME=reservo
DB_PASSWORD=secret

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173

FILESYSTEM_DISK=local

# PayDunya (primary): https://paydunya.com
PAYDUNYA_MASTER_KEY=your_master_key
PAYDUNYA_PRIVATE_KEY=your_private_key
PAYDUNYA_PUBLIC_KEY=your_public_key
PAYDUNYA_TOKEN=your_token
PAYDUNYA_MODE=test

# Stripe (optional)
STRIPE_KEY=pk_test_replace_me
STRIPE_SECRET=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
